rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /social_profiles/{uid} {
      // Read allowed if user is the owner or their UID is in allowedReaders
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.allowedReaders);
      // Write only if user is owner
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /friend_requests/{target}/requests/{from} {
      // Create allowed if sender is from (making request) or sender is target (accept marker)
      allow create: if request.auth != null && (request.auth.uid == from || request.auth.uid == target);
      // Read, update, and delete allowed for target and sender
      allow read, update, delete: if request.auth != null && (request.auth.uid == target || request.auth.uid == from);
    }
    
    // B02 Fix: Protect private sync paths
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    // Global collections
    match /public_meal_plans/{id} {
      allow read: if request.auth != null;
    }
    match /public_workout_plans/{id} {
      allow read: if request.auth != null;
    }
  }
}
