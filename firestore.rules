rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Social Profiles
    match /social_profiles/{uid} {
      // Allowed to read if it's my own profile, OR if I am in the allowedReaders array
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.allowedReaders);
      // Allowed to write/update only if it's my own profile
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Friend Requests
    // Path: friend_requests/{targetUid}/requests/{fromUid}
    match /friend_requests/{targetUid}/requests/{fromUid} {
      // Create is allowed if the user is the sender (making a request) 
      // OR if the user is the target (accepting a request via a marker to the sender)
      allow create: if request.auth != null && (request.auth.uid == fromUid || request.auth.uid == targetUid);
      
      // Read and delete are allowed for both the sender and the target
      allow read, delete: if request.auth != null && (request.auth.uid == fromUid || request.auth.uid == targetUid);
      
      // Update is not strictly needed, but can be allowed for the same parties
      allow update: if request.auth != null && (request.auth.uid == fromUid || request.auth.uid == targetUid);
    }
  }
}
