rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /social_profiles/{uid} {
      // Read allowed if user is the owner or their UID is in allowedReaders
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.allowedReaders);
      // Write only if user is owner
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /friend_requests/{target}/requests/{from} {
      // 1. Sender sending/updating a request
      allow create, update: if request.auth != null 
                    && request.auth.uid == from 
                    && request.resource.data.fromUid == from
                    && request.resource.data.accepted == false;
      
      // 2. Sender withdrawing or target declining/cleaning up
      allow delete: if request.auth != null 
                    && (request.auth.uid == from || request.auth.uid == target);
      
      // 3. Target accepting a request
      allow update: if request.auth != null 
                    && request.auth.uid == target 
                    && resource.data.accepted == false 
                    && request.resource.data.accepted == true;
                    
      // 4. Target pushing an acceptance marker to Sender
      allow create: if request.auth != null 
                    && request.auth.uid == from 
                    && request.resource.data.fromUid == from
                    && request.resource.data.accepted == true
                    && getAfter(/databases/$(database)/documents/friend_requests/$(from)/requests/$(target)).data.accepted == true;
                    
      allow read: if request.auth != null 
                  && (request.auth.uid == target || request.auth.uid == from);
    }
    
    // B02 Fix: Protect private sync paths
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    // Global collections
    match /public_meal_plans/{id} {
      allow read: if request.auth != null;
    }
    match /public_workout_plans/{id} {
      allow read: if request.auth != null;
    }
  }
}
