<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_compact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textColor="@color/sthira_peach"
        android:fontFamily="@font/general_sans_semibold"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Steps Hero -->
    <TextView
        android:id="@+id/tv_steps_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="@color/sthira_text_main"
        android:fontFamily="@font/cabinet_grotesk_extrabold"
        android:textSize="32sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="steps"
            android:textColor="@color/sthira_text_secondary"
            android:fontFamily="@font/general_sans"
            android:textSize="13sp" />
        
        <TextView
            android:id="@+id/tv_steps_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / --"
            android:textColor="@color/sthira_text_secondary"
            android:fontFamily="@font/general_sans"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_steps"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_layer_list" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Freshness -->
    <TextView
        android:id="@+id/tv_updated_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Updated --:--"
        android:textColor="@color/sthira_text_secondary"
        android:fontFamily="@font/general_sans"
        android:textSize="11sp"
        android:alpha="0.7" />

</LinearLayout>
