<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textColor="@color/sthira_peach"
            android:fontFamily="@font/general_sans_semibold"
            android:textSize="11sp"
            android:letterSpacing="0.1" />
        
        <TextView
            android:id="@+id/tv_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated --:--"
            android:textColor="@color/sthira_text_secondary"
            android:fontFamily="@font/general_sans"
            android:textSize="11sp"
            android:alpha="0.7" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        
        <!-- Left: Steps Hero -->
        <LinearLayout
            android:id="@+id/widget_steps_area"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/tv_steps_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/sthira_text_main"
                android:fontFamily="@font/cabinet_grotesk_extrabold"
                android:textSize="32sp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="steps"
                    android:textColor="@color/sthira_text_secondary"
                    android:fontFamily="@font/general_sans"
                    android:textSize="13sp" />
                
                <TextView
                    android:id="@+id/tv_steps_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / --"
                    android:textColor="@color/sthira_text_secondary"
                    android:fontFamily="@font/general_sans"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_layer_list" />
        </LinearLayout>

        <!-- Right: Tiles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- Meals Tile -->
            <LinearLayout
                android:id="@+id/widget_meals_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tile_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_meals_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-/-"
                        android:textColor="@color/sthira_text_main"
                        android:fontFamily="@font/general_sans_semibold"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meals logged"
                        android:textColor="@color/sthira_text_secondary"
                        android:fontFamily="@font/general_sans"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Go to meals" />
            </LinearLayout>

            <!-- Habits Tile -->
            <LinearLayout
                android:id="@+id/widget_habits_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tile_bg"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_habits_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-/-"
                        android:textColor="@color/sthira_text_main"
                        android:fontFamily="@font/general_sans_semibold"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habits done"
                        android:textColor="@color/sthira_text_secondary"
                        android:fontFamily="@font/general_sans"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Go to habits" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Nutrition Row -->
    <LinearLayout
        android:id="@+id/widget_nutrition_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nutrition"
            android:textColor="@color/sthira_text_secondary"
            android:fontFamily="@font/general_sans"
            android:textSize="13sp"
            android:layout_marginEnd="12dp" />
        <TextView
            android:id="@+id/tv_nutrition_energy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- kcal"
            android:textColor="@color/sthira_text_main"
            android:fontFamily="@font/cabinet_grotesk_bold"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/tv_nutrition_protein"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- g protein"
            android:textColor="@color/sthira_text_main"
            android:fontFamily="@font/cabinet_grotesk_bold"
            android:textSize="15sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Workout Row -->
    <LinearLayout
        android:id="@+id/widget_workout_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tile_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_workout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout"
                android:textColor="@color/sthira_peach"
                android:fontFamily="@font/general_sans_semibold"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_workout_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/sthira_text_secondary"
                android:fontFamily="@font/general_sans"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Go to workout" />
    </LinearLayout>

</LinearLayout>
